---
import { profile } from "~/data/profile";
import { withBase } from "~/utils/assets";
---

<header class="site-header">
  <a class="brand" href={withBase("/")} aria-label={`${profile.name} portfolio home`}>
    <span class="brand__mark" aria-hidden="true">
      <svg viewBox="0 0 36 36" width="32" height="32">
        <rect x="1" y="1" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.4"></rect>
        <path
          d="M11 9h4v14a4 4 0 0 1-4 4H8M21 9h6m-6 0v18m6-18v18M14 18h7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="square"
        ></path>
      </svg>
    </span>
    <span class="brand__text">
      <strong>{profile.name}</strong>
      <small class="mono">{profile.fullName} · {profile.title}</small>
    </span>
  </a>
  <nav class="site-nav" aria-label="Portfolio sections">
    <a href="#resume" data-nav-target="resume"><i class="mono">00</i><span>Profile</span></a>
    <a href="#work" data-nav-target="work"><i class="mono">01</i><span>Index</span></a>
    <a href="#between" data-nav-target="between"><i class="mono">02</i><span>Works</span></a>
    <a href="#contact" data-nav-target="contact"><i class="mono">03</i><span>Contact</span></a>
    <a class="site-nav__pdf" href={withBase("/assets/Jim-Sun-Architecture-Portfolio.pdf")}>
      <i class="mono">PDF</i><span>Original</span>
    </a>
  </nav>
</header>
